rules_version = '2';

// ExpenseFlow Firebase Storage Security Rules
//
// Receipt images live at receipts/{userId}/{transactionId}.jpg
// Only the owning authenticated user may read or write their own receipts.
// Demo mode never uploads to Storage — see StorageService / TransactionRepository.
service firebase.storage {
  match /b/{bucket}/o {
    match /receipts/{userId}/{fileName} {
      allow read, write: if request.auth != null
                          && request.auth.uid == userId
                          && request.resource.size < 10 * 1024 * 1024
                          && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
