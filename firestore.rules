rules_version = '2';

// ExpenseFlow Firestore Security Rules
//
// Data model: users/{userId}/{transactions|budgets|recurring|categories}/{docId}
//             users/{userId}/profile/data
//             users/{userId}/settings/data
//
// Every read/write is scoped to the authenticated user's own uid.
// No user can ever read or write another user's financial data.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /transactions/{transactionId} {
        allow read, write: if isOwner(userId);
      }

      match /budgets/{budgetId} {
        allow read, write: if isOwner(userId);
      }

      match /recurring/{recurringId} {
        allow read, write: if isOwner(userId);
      }

      match /categories/{categoryId} {
        allow read, write: if isOwner(userId);
      }

      match /profile/{docId} {
        allow read, write: if isOwner(userId);
      }

      match /settings/{docId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
